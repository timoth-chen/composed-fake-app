.DS_Store
.env
.env.*
node_modules/
.cache/
*.log
# Retain obsolete image iterations locally; ship the active cutouts and turn sheets.
dist/assets/model-*.webp
dist/assets/mannequin-[0-9].jpg
dist/assets/mannequin-cream-*.png
dist/assets/denim.png
dist/assets/shorts.png
dist/assets/date-night.png

# Content-hashed build outputs; canonical sources above remain tracked.
# Existing published bundles stay tracked for cached HTML compatibility.
/dist/app.*.js
/dist/style.*.css
/dist/landing-reference.*.css
/dist/source-rail.*.css
/dist/app-shell.*.css
/dist/today-first.*.css

# Local QA evidence belongs in .cache/qa, not committed previews.
/previews/*-live/
/previews/*-normal/
/previews/style-pies-detail/
/previews/today-sync-recording/
/previews/rack-now/

# Keep original personal media and superseded face/mannequin sheets untracked.
/public/wardrobe-timothy/*

!/public/wardrobe-timothy/casual-ghost-v1.png
!/public/wardrobe-timothy/everyday-clogs-ghost-v1.png
!/public/wardrobe-timothy/everyday-roger-ghost-v1.png
!/public/wardrobe-timothy/date-ghost-v1.png
!/public/wardrobe-timothy/pieces-atlas-v1.png
!/public/wardrobe-timothy/trousers-fit-v2.png
!/public/wardrobe-timothy/archivo-400.ttf
!/public/wardrobe-timothy/archivo-500.ttf
!/public/wardrobe-timothy/archivo-600.ttf
!/public/wardrobe-timothy/archivo-700.ttf
!/public/wardrobe-timothy/casual-headless-v1.png
!/public/wardrobe-timothy/everyday-clogs-headless-v1.png
!/public/wardrobe-timothy/everyday-roger-headless-v1.png
!/public/wardrobe-timothy/date-headless-v1.png

/timothy-dist/

